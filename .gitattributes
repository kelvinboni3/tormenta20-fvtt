# Os compendios sao bancos LevelDB. Qualquer conversao de fim de linha os corrompe:
# o arquivo CURRENT ganha \r e o LevelDB passa a procurar por "MANIFEST-000006\r",
# um nome invalido no Windows, e o pack nao abre.
packs/** -text -diff

# Demais binarios
*.ldb   binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.svg   text eol=lf
*.ogg   binary
*.webm  binary

# Fontes: sempre LF
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.hbs   text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
