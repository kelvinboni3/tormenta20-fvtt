{
  "name": "tormenta20-homebrew",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ferramentas de build para a camada homebrew do sistema Tormenta20.",
  "scripts": {
    "unpack": "node ./tools/packs.mjs unpack",
    "pack": "npm run validar && node ./tools/packs.mjs pack",
    "validar": "node ./tools/validar.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.3",
    "js-yaml": "^4.3.1"
  }
}
